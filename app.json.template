{
  "application": {
    "name": "codecrafters-arch-installer",
    "version": "1.0.2",
    "require_root": true
  },
  "settings": {
    "dry_run": true,
    "stop_on_error": true
  },
  "operations": [
    {
      "function": "get_all_disks",
      "parameters": {}
    },
    {
      "function": "collect_profile",
      "parameters": {}
    },
    {
      "function": "dev_tools",
      "parameters": {
        "confirm": false
      }
    },
    {
      "function": "install_desktop",
      "parameters": {
        "desktop": "{{DESKTOP_ENV}}",
        "confirm": false
      }
    },
    {
      "function": "install_packages",
      "parameters": {
        "packages": {{BASE_PACKAGES}},
        "confirm": false
      }
    },
    {
      "function": "crypt_setup",
      "parameters": {
        "disk": "{{TARGET_DISK}}",
        "password": "{{LUKS_PASSWORD}}",
        "name": "cryptroot",
        "crypt_type": "luks2",
        "confirm": false,
        "timeout": 300
      }
    },
    {
      "function": "pv_create",
      "parameters": {
        "device": "/dev/mapper/cryptroot",
        "confirm": false
      }
    },
    {
      "function": "vg_create",
      "parameters": {
        "vg_name": "archvg",
        "device": "/dev/mapper/cryptroot",
        "confirm": false
      }
    },
    {
      "function": "lv_create",
      "parameters": {
        "vg_name": "archvg",
        "lv_name": "root",
        "size": "100%FREE",
        "confirm": false
      }
    },
    {
      "function": "btrfs_disk_setup",
      "parameters": {
        "disk": "/dev/mapper/archvg-root",
        "label": "ARCH",
        "confirm": false,
        "timeout": 300
      }
    },
    {
      "function": "install_grub",
      "parameters": {
        "root_mount": "/mnt",
        "boot_mode": "{{BOOT_MODE}}",
        "efi_directory": "{{EFI_DIRECTORY}}",
        "bootloader_id": "GRUB",
        "crypt_device": "{{TARGET_DISK}}",
        "crypt_mapper": "cryptroot",
        "configure_encrypted_boot": true,
        "confirm": false,
        "timeout": 300
      }
    },
    {
      "function": "write_crypttab",
      "parameters": {
        "target_root": "/mnt",
        "entries": [
          {
            "target": "cryptroot",
            "source": "{{TARGET_DISK}}",
            "key_file": "none",
            "options": "luks"
          }
        ],
        "confirm": false
      }
    },
    {
      "function": "configure_mkinitcpio_hooks",
      "parameters": {
        "target_root": "/mnt",
        "hooks": ["base", "udev", "autodetect", "keyboard", "keymap", "consolefont", "block", "encrypt", "lvm2", "filesystems", "fsck"],
        "confirm": false
      }
    },
    {
      "function": "regenerate_initramfs",
      "parameters": {
        "target_root": "/mnt",
        "confirm": false
      }
    },
    {
      "function": "setup_default_groups",
      "parameters": {
        "confirm": false
      }
    },
    {
      "function": "create_user",
      "parameters": {
        "username": "{{USERNAME}}",
        "password": "{{USER_PASSWORD}}",
        "shell": "/bin/bash",
        "groups": ["wheel", "audio", "video", "storage", "network"],
        "confirm": false
      }
    },
    {
      "function": "setup_sudo_access",
      "parameters": {
        "username": "{{USERNAME}}",
        "confirm": false
      }
    }
  ]
}
